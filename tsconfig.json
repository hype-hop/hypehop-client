{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "jsx": "preserve",
    "moduleResolution": "nodenext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    
    "src/",
    ".next/types/**/*.ts",
    "svgr.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "baseUrl": ".",   
}
